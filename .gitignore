# Build output
build/
out/
release/
dist/
target/
node_modules/
.gradle/

# Rust / Cargo (keep Cargo.lock tracked when present)
**/*.rs.bk

# Fabric/Minecraft client runtime state
aether-client/run/

# The toolchain that is downloaded by tools/setup.ps1
tools/gradle-*/
tools/jdk*/
tools/*.zip

# Runtime state of the launcher, anchored to the repository root: a bare "Aether/" matched the
# package folder dev/aether/ on a case-insensitive file system and hid every Java source of the mod.
/.aether/
/Aether/

# Editors / IDE
.idea/
.vscode/
*.iml

# OS files
.DS_Store
Thumbs.db

# Captures and throwaway homes produced by the theme sweep and the end-to-end replay
tools/theme-pages-install/
tools/e2e/shots-replay/
tools/e2e/home-replay-*
tools/e2e/pids-replay.txt
tools/ui-home/
tools/test-home/

# Binaries built at the repository root by build.bat. GitHub Releases (with SHA256SUMS) is the
# delivery channel, so the repository never carries a binary it cannot prove comes from the source.
# The two E2E helpers in tools/e2e/ stay tracked: they are fixtures compiled from the .rs files
# next to them, and the manual replay needs them without a Rust toolchain.
/*.exe

# Real Fabric/Minecraft server installations used during local testing: libraries, logs, worlds and
# a fabric-server-launcher.properties that names an absolute path of the machine that ran the test.
/tools/fabric-host-test/
/tools/fabric-server-test/

# Logs and temporary files
*.log
*.pdb

# Logs written by the client at run time (*.log.gz keeps a rotated copy)
aether-client/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

tools/installed-shots*/
tools/mc/
tools/mc-sources/
tools/fapi-modules/
tools/aether-home/
tools/api/
tools/__pycache__/
launcher/__pycache__/
aether-client/bin/
aether-client/.classpath
aether-client/.project
aether-client/.settings/
launcher/gui/.cache/
