{
  "name": "aether-launcher",
  "version": "1.0.0",
  "description": "Aether Launcher: Rust game-management core and Tauri 2 native desktop shell.",
  "main": "gui/src/main.cjs",
  "author": "Aether",
  "license": "MIT",
  "scripts": {
    "start": "npm run core && cargo run --manifest-path desktop/Cargo.toml",
    "build:exe": "npm run build:desktop && node ../tools/copy-desktop-launcher.mjs",
    "core": "cargo build --release",
    "core:debug": "cargo build",
    "test": "cargo test --release",
    "test:security": "node --test tests/security.test.cjs",
    "lint": "cargo clippy --release --all-targets",
    "e2e:drive": "node ../tools/e2e/drive.mjs",
    "e2e:screens": "node ../tools/e2e/screens.mjs",
    "e2e:failure": "node ../tools/e2e/failure.mjs",
    "e2e:crash": "node ../tools/e2e/crash-report.mjs",
    "e2e:cancel": "node ../tools/e2e/cancel.mjs",
    "e2e:stubborn": "node ../tools/e2e/stubborn.mjs",
    "e2e:timeout": "node ../tools/e2e/timeout.mjs",
    "e2e:a11y": "node ../tools/e2e/a11y.mjs",
    "e2e:profiles": "node ../tools/e2e/profiles.mjs",
    "e2e:sliders": "node ../tools/e2e/sliders.mjs",
    "start:tauri": "npm run core && cargo run --manifest-path desktop/Cargo.toml",
    "start:electron": "electron .",
    "build:desktop": "npm run core && cargo build --release --manifest-path desktop/Cargo.toml",
    "test:desktop": "cargo test --manifest-path desktop/Cargo.toml",
    "dist:desktop": "cargo tauri build --manifest-path desktop/Cargo.toml",
    "pack:electron": "electron-builder --dir",
    "dist:electron": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.3.1"
  },
  "build": {
    "appId": "dev.aether.launcher",
    "productName": "Aether Launcher",
    "files": [
      "gui/**/*",
      "src/**/*",
      "tests/**/*",
      "Cargo.toml",
      "Cargo.lock",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "target/release",
        "to": ".",
        "filter": [
          "aether-launcher",
          "aether-launcher.exe"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
