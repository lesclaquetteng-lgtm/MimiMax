{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CUBE Launcher",
  "version": "1.0.0",
  "identifier": "dev.aether.launcher",
  "build": {
    "frontendDist": "../gui/src/ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CUBE Launcher",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#0e0f13",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Aether",
    "copyright": "Copyright (c) 2026 Aether",
    "category": "Game",
    "shortDescription": "Le launcher Minecraft de CUBE : comptes hors-ligne, Fabric et serveurs locaux.",
    "longDescription": "CUBE Launcher installe et lance Minecraft avec Fabric : comptes hors-ligne et Microsoft, serveurs, hébergement local et pack d'optimisation vérifié.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "licenseFile": "installer/LICENSE-FR.txt",
    "resources": {
      "installer/LICENSE-FR.txt": "AETHER-LICENSE-FR.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "template": "installer/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "startMenuFolder": "CUBE",
        "compression": "lzma"
      }
    }
  }
}
